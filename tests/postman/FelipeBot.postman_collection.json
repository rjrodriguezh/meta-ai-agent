{
  "info": {
    "name": "Bot Felipe Castillo - QA Suite",
    "description": "Suite de pruebas automatizadas para el bot de WhatsApp del Kinesiólogo Felipe Castillo.\nCubre: precios, FONASA, diagnósticos, servicios no disponibles, agendamiento y cancelación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "felipe-bot-qa-v1"
  },
  "variable": [
    { "key": "AI_URL", "value": "http://localhost:8081" },
    { "key": "PHONE", "value": "56900000099" }
  ],
  "item": [
    {
      "name": "💰 Precios y Tarifas",
      "item": [
        {
          "name": "Cuánto vale la sesión",
          "request": {
            "method": "POST",
            "url": "{{AI_URL}}/process",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"numero\": \"{{PHONE}}\", \"mensaje\": \"¿Cuánto vale la sesión?\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Menciona precio $10.000', function() {",
            "  const r = pm.response.json().respuesta.toLowerCase();",
            "  pm.expect(r).to.match(/10[.,]?000|diez/);",
            "});"
          ]}}]
        },
        {
          "name": "Valor particular",
          "request": {
            "method": "POST",
            "url": "{{AI_URL}}/process",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"numero\": \"{{PHONE}}\", \"mensaje\": \"Valor particular por favor\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Responde con precio', function() {",
            "  const r = pm.response.json().respuesta.toLowerCase();",
            "  pm.expect(r).to.match(/10[.,]?000|diez/);",
            "});"
          ]}}]
        },
        {
          "name": "Cuánto salen 5 sesiones",
          "request": {
            "method": "POST",
            "url": "{{AI_URL}}/process",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"numero\": \"{{PHONE}}\", \"mensaje\": \"¿Cuánto salen 5 sesiones?\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Indica que no hay promo de 5', function() {",
            "  const r = pm.response.json().respuesta.toLowerCase();",
            "  pm.expect(r).to.satisfy(s => s.includes('10') || s.includes('promo') || s.includes('solo'));",
            "});"
          ]}}]
        },
        {
          "name": "Programa de 10 sesiones ($37.000)",
          "request": {
            "method": "POST",
            "url": "{{AI_URL}}/process",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"numero\": \"{{PHONE}}\", \"mensaje\": \"El bono vale $37.000\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Aclara que es programa de 10 sesiones', function() {",
            "  const r = pm.response.json().respuesta.toLowerCase();",
            "  pm.expect(r).to.satisfy(s => s.includes('10') || s.includes('programa') || s.includes('37'));",
            "});"
          ]}}]
        },
        {
          "name": "No bonos online",
          "request": {
            "method": "POST",
            "url": "{{AI_URL}}/process",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"numero\": \"{{PHONE}}\", \"mensaje\": \"¿Aceptan bonos online?\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Indica que no acepta bonos online', function() {",
            "  const r = pm.response.json().respuesta.toLowerCase();",
            "  pm.expect(r).to.satisfy(s => s.includes('no') || s.includes('santiago') || s.includes('presencial'));",
            "});"
          ]}}]
        }
      ]
